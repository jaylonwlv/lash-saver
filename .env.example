# Copy to .env.local for local development. Set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser: never put secrets in them.

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Lash Saver"

# --- Supabase (Project Settings → API Keys) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Bypasses RLS. Server only.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Used by the Supabase CLI for migrations and type generation, not by the app.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Stripe (Dashboard → Developers → API keys) ----------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Platform events endpoint: /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Connected-accounts events endpoint: /api/stripe/connect/webhook
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
# Platform fee per deposit in basis points (100 = 1%). 0 = no fee.
STRIPE_PLATFORM_FEE_BPS=0

# --- Resend (resend.com → API Keys; sending domain must be verified) --------
RESEND_API_KEY=re_xxx
EMAIL_FROM="Lash Saver <bookings@yourdomain.com>"
EMAIL_REPLY_TO=support@yourdomain.com

# --- Vercel Cron ------------------------------------------------------------
# Random string, at least 16 chars. Vercel sends it as a Bearer token to cron routes.
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- SMS (not wired to a real provider yet) ---------------------------------
# none = texting off, log = print messages to the server console
SMS_PROVIDER=none
# Example keys for a future provider, e.g. Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
